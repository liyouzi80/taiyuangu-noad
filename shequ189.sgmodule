#!name=天翼智慧社区 去广告
#!desc=微信里打开的天翼智慧社区（w.shequ.189.cn）：清空广告接口；首页只保留「访客预约」「通行证」「全部」，底部去掉「生活」「活动」tab，屏蔽 ux.21cn 统计（v1.4，Shadowrocket/Surge 版）
#!author=liyouzi80
#!system=ios
#!date=2026-11-04

[Rule]
DOMAIN,ux.21cn.com,REJECT

[Script]
天翼社区-广告接口 = type=http-response,pattern=^https?://w\.shequ\.189\.cn/(.*/)?(wechat/ad/query|saas/all/ad/query|community-life-ad/(list|info)),requires-body=1,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/liyouzi80/taiyuangu-noad/main/scripts/shequ189.js
天翼社区-禁用缓存 = type=http-request,pattern=^https?://(w\.shequ\.189\.cn/communityFw/h5/(index\.html)?|h5-shequ\.dlife\.cn/h5/saas/communityFw/h5/app\.[0-9a-f]+\.js)(\?|$),timeout=10,script-path=https://raw.githubusercontent.com/liyouzi80/taiyuangu-noad/main/scripts/shequ189.js
天翼社区-隐藏横幅 = type=http-response,pattern=^https?://(w\.shequ\.189\.cn/communityFw/h5/(index\.html)?|h5-shequ\.dlife\.cn/h5/saas/communityFw/h5/app\.[0-9a-f]+\.js)(\?|$),requires-body=1,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/liyouzi80/taiyuangu-noad/main/scripts/shequ189.js

[MITM]
hostname = %APPEND% w.shequ.189.cn, h5-shequ.dlife.cn
